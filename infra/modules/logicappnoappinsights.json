    "hostingPlanName": "[parameters('appName')]",
    "storageAccountName": "[format('{0}logicapp', uniqueString(resourceGroup().id))]",
    "managementbaseuri": "[environment().resourceManager]",
    "blobEndpoint": "[format('https://{0}.blob.{1}', variables('storageAccountName'), environment().suffixes.storage)]",
